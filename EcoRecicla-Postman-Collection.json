{
  "info": {
    "_postman_id": "9be7a7c4-b44e-4950-a8ef-ec0eec01ec01",
    "name": "EcoRecicla API",
    "description": "Colección de prueba del backend EcoAPI. Ejecuta primero Login para guardar el JWT automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "pointId",
      "value": "1"
    },
    {
      "key": "weighingId",
      "value": "15"
    },
    {
      "key": "routeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Login operario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "description": "Público. Guarda el token JWT en la variable de colección para los demás requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"operario1\",\n  \"contrasena\": \"Eco2026*\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "if (body.token) pm.collectionVariables.set('token', body.token);",
              "pm.test('Token recibido', function () { pm.expect(body.token).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Usuario actual",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/auth/me",
        "description": "Devuelve usuario, rol y privilegios del JWT."
      }
    },
    {
      "name": "03 - Salud de la API",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health",
        "description": "La ruta de salud también exige token según la consigna."
      }
    },
    {
      "name": "04 - Puntos paginados",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/puntos?page=0&size=20",
        "description": "Lista de puntos y envoltorio de paginación."
      }
    },
    {
      "name": "05 - Puntos por zona",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/puntos?page=0&size=20&zona=Norte",
        "description": "Prueba el filtro por zona."
      }
    },
    {
      "name": "06 - Ruta del día",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/rutas/dia",
        "description": "Devuelve la ruta asignada al usuario actual y los puntos en orden."
      }
    },
    {
      "name": "07 - Pesajes de un punto",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/puntos/{{pointId}}/pesajes?page=0&size=20",
        "description": "Listado paginado del más reciente al más antiguo."
      }
    },
    {
      "name": "08 - Registrar pesaje",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/puntos/{{pointId}}/pesajes",
        "description": "El servidor calcula pesoNeto; no enviar ese campo.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"material\": \"Papel\",\n  \"pesoBruto\": 25.5,\n  \"tara\": 2.5,\n  \"observacion\": \"Prueba desde Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 - Corregir pesaje",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/pesajes/{{weighingId}}",
        "description": "Prueba con operario1 solo para sus propios registros del día. Cambia weighingId a un registro creado hoy por operario1.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"material\": \"Papel\",\n  \"pesoBruto\": 27.5,\n  \"tara\": 2.5,\n  \"observacion\": \"Corrección de prueba\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 - Anular pesaje (supervisor)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/pesajes/{{weighingId}}/anular",
        "description": "Requiere supervisor1. Ejecuta de nuevo el request Login cambiando el usuario primero.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivo\": \"Anulación de prueba\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11 - Crear punto (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/puntos",
        "description": "Requiere el usuario admin.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"razonSocial\": \"Empresa de prueba S.A.C.\",\n  \"direccion\": \"Av. Prueba 123\",\n  \"zona\": \"Norte\",\n  \"materialHabitual\": \"Papel\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "12 - Cerrar ruta (supervisor)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/rutas/{{routeId}}/cerrar",
        "description": "Requiere privilegio RUTA_CERRAR. La ruta de hoy tiene puntos pendientes; se espera 409 hasta completar todos los puntos o registrar motivo de omisión."
      }
    }
  ]
}
